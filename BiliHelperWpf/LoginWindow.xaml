<Window x:Class="BiliHelperWpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="B 站扫码登录"
        Width="360" Height="480"
        MinWidth="360" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- LoginWindow 独立窗口，无法引用 MainWindow 里的 SecondaryButtonStyle，
             这里定义本地版本（画刷走应用级 DynamicResource，随主题切换）。 -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <!-- 主内容 -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="28,28,28,24">
            <StackPanel VerticalAlignment="Center">
                <!-- 标题 -->
                <TextBlock Text="🎫 B 站扫码登录"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="请用 B 站 App 扫描下方二维码"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,20" />

                <!-- 二维码 -->
                <Border Background="{DynamicResource InputBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="220" Height="220"
                        HorizontalAlignment="Center"
                        Padding="6">
                    <Image x:Name="QrImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <!-- 状态文本 -->
                <TextBlock x:Name="StatusText"
                           Text="正在生成二维码..."
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,22" />

                <!-- 操作按钮 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="取消"
                            x:Name="CancelButton"
                            Style="{StaticResource LoginButtonStyle}"
                            FontSize="13" Margin="0,0,6,0"
                            Click="CancelButton_Click" />
                    <Button Grid.Column="1"
                            Content="重新生成"
                            x:Name="RegenButton"
                            Style="{StaticResource LoginButtonStyle}"
                            FontSize="13" Margin="6,0,0,0"
                            IsEnabled="False"
                            Click="RegenButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 右上角关闭按钮（在 Border 之后声明，确保绘制在最上层）；
             样式对齐主界面 CloseButtonStyle：矩形、hover 红色 + 白字 -->
        <Button x:Name="CloseXButton"
                Content="✕"
                FontSize="14"
                Width="46" Height="32"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Foreground="{DynamicResource TextPrimaryBrush}"
                Click="CloseXButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseButtonHoverBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseButtonPressedBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>