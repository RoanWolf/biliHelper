<Window x:Class="BiliHelperWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:BiliHelperWpf.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="BiliHelper"
        Height="800" Width="1200"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="pack://application:,,,/BiliHelperWpf;component/Assets/#Lilex Duo, Microsoft YaHei, PingFang SC, sans-serif"
        FontSize="14"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="4"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverted="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:StatusToColorConverter x:Key="StatusToColor" />

        <!-- 标题栏按钮样式 -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TitleBarPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮样式 -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseButtonPressedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分P列表项样式 -->
        <Style x:Key="PartItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 字幕条目样式 -->
        <Style x:Key="SubItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />    <!-- 自定义标题栏 -->
            <RowDefinition Height="Auto" />  <!-- URL 输入行 -->
            <RowDefinition Height="Auto" />  <!-- 进度 -->
            <RowDefinition Height="Auto" />  <!-- 错误 -->
            <RowDefinition Height="Auto" />  <!-- 元信息 -->
            <RowDefinition Height="*" />     <!-- 主体 -->
            <RowDefinition Height="Auto" />  <!-- 底栏 -->
        </Grid.RowDefinitions>

        <!-- ═══ 自定义标题栏 ═══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                x:Name="TitleBar"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>

                <!-- 标题（拖动区域） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="False">
                    <Image Source="Assets/logo.png"
                           Width="20" Height="20"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                    <TextBlock Text="BiliHelper"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Ellipse Width="4" Height="4"
                             Fill="{DynamicResource TextMutedBrush}"
                             VerticalAlignment="Center"
                             Margin="8,0" />
                    <TextBlock Text="B 站字幕查看器"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- 中间空白拖拽区域 -->
                <Rectangle Grid.Column="1" Fill="Transparent"
                           shell:WindowChrome.IsHitTestVisibleInChrome="False" />

                <!-- 设置 -->
                <Button Grid.Column="2"
                        Style="{StaticResource TitleBarButtonStyle}"
                        x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="设置">
                    <TextBlock Text="⚙️"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- 主题切换 -->
                <Button Grid.Column="3"
                        Style="{StaticResource TitleBarButtonStyle}"
                        x:Name="ThemeToggleButton"
                        Click="ThemeToggleButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        ToolTip="切换主题"
                        FontSize="14">
                    <TextBlock x:Name="ThemeToggleIcon" Text="☀️"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>

                <!-- 最小化 -->
                <Button Grid.Column="4"
                        Style="{DynamicResource TitleBarButtonStyle}"
                        x:Name="MinimizeButton"
                        Click="MinimizeButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M0,0 L10,0"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeThickness="1.2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                </Button>

                <!-- 最大化/还原 -->
                <Button Grid.Column="5"
                        Style="{DynamicResource TitleBarButtonStyle}"
                        x:Name="MaximizeButton"
                        Click="MaximizeButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Width="10" Height="10">
                        <Path x:Name="MaxIcon"
                              Data="M0,0 L10,0 L10,10 L0,10 Z"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.2"
                              Fill="Transparent" />
                        <Path x:Name="RestoreIcon"
                              Data="M2,2 L10,2 L10,10 L2,10 Z M0,0 L8,0 L8,8 L0,8 Z"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.2"
                              Fill="{DynamicResource SurfaceBrush}"
                              Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- 关闭 -->
                <Button Grid.Column="6"
                        Style="{DynamicResource CloseButtonStyle}"
                        x:Name="CloseButton"
                        Click="CloseButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeThickness="1.2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- ═══ URL 输入行 ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" Padding="16,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="12,8" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource PrimaryBrush}"
                                 VerticalContentAlignment="Center" />
                    </Border>

                    <Button Grid.Column="1"
                            Content="拉取字幕"
                            Command="{Binding FetchCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Height="38" Margin="8,0,0,0"
                            Padding="20,0" FontSize="13" />

                    <!-- 历史记录按钮 -->
                    <Button Grid.Column="2"
                            Content="📋 历史"
                            Command="{Binding ToggleHistoryCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Height="38" Margin="8,0,0,0"
                            Padding="14,0"
                            FontSize="13" />
                    <!-- B 站 cookie 状态按钮 -->
                    <Button Grid.Column="3"
                            x:Name="CookieButton"
                            FontSize="16"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Height="38" Margin="8,0,0,0"
                            Padding="10,0"
                            Click="CookieButton_Click"
                            ToolTip="{Binding CookieTooltip}">
                        <TextBlock x:Name="CookieIcon" Text="🍪" FontSize="16" />
                    </Button>
                </Grid>
                <TextBlock Text="💡 支持 BV 号 / 完整 URL / 多P合集 / 自动识别字幕语言"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- ═══ 进度条行 ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                Padding="16,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0"
                             Value="{Binding ProgressPercent}"
                             Minimum="0" Maximum="100"
                             Height="6"
                             Foreground="{DynamicResource PrimaryBrush}"
                             Background="{DynamicResource BorderBrush}"
                             BorderThickness="0" />

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ 错误行 ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" Padding="16,8"
                BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource ErrorBrush}"
                       FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- ═══ 视频元信息 ═══ -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" Padding="16,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasVideoInfo, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="12" Height="12"
                         Fill="{Binding VideoInfo.Status, Converter={StaticResource StatusToColor}}"
                         VerticalAlignment="Center" Margin="0,0,10,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VideoInfo.Title}"
                               FontSize="16" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" MaxWidth="500" />
                    <TextBlock Text="{Binding VideoInfo.BvId, StringFormat='  ·  {0}'}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VideoInfo.StatusDisplay, StringFormat='  ·  {0}'}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding VideoInfo.TotalSubtitleCount, StringFormat='共 {0} 条字幕'}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding VideoInfo.TotalParts, StringFormat='共 {0}P'}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═══ 主体区域 ═══ -->
        <Grid Grid.Row="5">
            <!-- 有数据时 -->
            <Grid Visibility="{Binding HasVideoInfo, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：分P列表 -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="14,10">
                            <TextBlock Text="{Binding VideoInfo.TotalParts, StringFormat='📋 分P 列表 ({0})'}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding VideoInfo.Parts}"
                                 SelectedItem="{Binding SelectedPart}"
                                 ItemContainerStyle="{DynamicResource PartItemStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="8" Height="8"
                                                 VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSubtitles}" Value="False">
                                                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}"
                                                   FontSize="13" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding DurationFormatted}"
                                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="4"
                              Background="Transparent"
                              HorizontalAlignment="Center"
                              ResizeDirection="Columns" />

                <!-- 右侧：字幕区域 -->
                <Border Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ═══ TAB 栏 ═══ -->
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 原始字幕 TAB -->
                                <Border Grid.Column="0"
                                        x:Name="TabOriginal"
                                        PreviewMouseDown="SubtitleTab_PreviewMouseDown"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Padding="16,8,16,8"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSubtitleTab}" Value="0">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="原始字幕"
                                               FontSize="13" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSubtitleTab}" Value="0">
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <!-- 原始全文 TAB -->
                                <Border Grid.Column="1"
                                        x:Name="TabFullText"
                                        PreviewMouseDown="SubtitleTab_PreviewMouseDown"
                                        Background="Transparent"
                                        Padding="16,8,16,8"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0,0,0,2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSubtitleTab}" Value="1">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="AI润色"
                                               FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSubtitleTab}" Value="1">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                            </Grid>
                        </Border>

                        <!-- 原始字幕内容（SelectedSubtitleTab == 0） -->
                        <Grid Grid.Row="1" Visibility="{Binding IsOriginalSubtitleVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 搜索栏 -->
                            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{DynamicResource InputBgBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4" Height="32">
                                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13" Padding="8,0" BorderThickness="0"
                                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 CaretBrush="{DynamicResource PrimaryBrush}"
                                                 VerticalContentAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding FilteredCount}"
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- 无选中分P时的占位 -->
                            <TextBlock Grid.Row="1"
                                       Text="← 从左侧选择一个分P"
                                       FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedPart, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />

                            <!-- 字幕列表容器 -->
                            <Grid Grid.Row="2">
                                <ListBox x:Name="SubtitleListBox"
                                         ItemsSource="{Binding FilteredEntries}"
                                         ItemContainerStyle="{DynamicResource SubItemStyle}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Grid.Column="0"
                                                        Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4"
                                                        Padding="8,4" VerticalAlignment="Top"
                                                        Margin="0,0,10,0" MinWidth="80">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding StartTimeFormatted}"
                                                                   FontSize="12" FontFamily="pack://application:,,,/BiliHelperWpf;component/Assets/#Lilex Duo"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding EndTimeFormatted}"
                                                                   FontSize="10" FontFamily="pack://application:,,,/BiliHelperWpf;component/Assets/#Lilex Duo"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       FontSize="14" TextWrapping="Wrap"
                                                       LineHeight="22" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>

                        <!-- AI润色内容（SelectedSubtitleTab == 1） -->
                        <Grid Grid.Row="1" Visibility="{Binding IsFullTextVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />  <!-- 错误 -->
                                <RowDefinition Height="Auto" />  <!-- 无选中分P占位 -->
                                <RowDefinition Height="*" />     <!-- 内容区：未整理卡片 / 段落列表 -->
                            </Grid.RowDefinitions>

                            <!-- 错误提示 -->
                            <Border Grid.Row="0" Background="{DynamicResource ErrorBackgroundBrush}"
                                    BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="0,0,0,1"
                                    Padding="12,8"
                                    Visibility="{Binding AiReadError, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="AI 整理失败"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ErrorBrush}" />
                                    <TextBlock Text="{Binding AiReadErrorMessage}"
                                               FontSize="11" Foreground="{DynamicResource ErrorBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 无选中分P时的占位 -->
                            <TextBlock Grid.Row="1"
                                       Text="← 从左侧选择一个分P"
                                       FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedPart, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />

                            <!-- 未整理时的占位（有选中分P，但还没有 AI 段落） -->
                            <Border Grid.Row="2"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="48,36"
                                    MaxWidth="400"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowAiReadEmptyCard, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📄"
                                               FontSize="44"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="该分P 尚未进行 AI 整理"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,16,0,0" />
                                    <TextBlock Text="AI 将修正错别字、添加标点并分段，生成适合阅读的全文"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0" />
                                    <!-- 整理中隐藏按钮，进度文本显示在按钮下方 -->
                                    <Button Content="✨ 立即整理当前分P"
                                            Command="{Binding AiReadCommand}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Height="36"
                                            Padding="20,0"
                                            Margin="0,20,0,0"
                                            FontSize="13"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding IsAiReadBusy, Converter={StaticResource InverseBoolToVis}}">
                                    </Button>
                                    <TextBlock Text="{Binding AiReadStatus}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,14,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 段落列表（已整理的阅读版） -->
                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="24,16"
                                          Background="Transparent"
                                          Visibility="{Binding HasAiParagraphs, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding AiParagraphs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,18">
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="15" LineHeight="28" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding SourceStartIndex, StringFormat='↳ 字幕 #{0}'}"
                                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>


                    </Grid>
                </Border>
            </Grid>

            <!-- 空状态占位 -->
            <Border Background="{DynamicResource BackgroundBrush}"
                    Visibility="{Binding HasVideoInfo, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎬" FontSize="64" HorizontalAlignment="Center" />
                    <TextBlock Text="输入视频 URL 并点击「拉取字幕」"
                               FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="支持 BV 号 · 完整链接 · 多P 视频 · AI 字幕 / CC 字幕"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ 底栏 ═══ -->
        <Border Grid.Row="6" Background="{DynamicResource SurfaceBrush}" Padding="16,6"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <!-- 右下角调整大小手柄 -->
                <Border Grid.Column="1" Width="16" Height="14"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Opacity="0.4">
                    <Path Data="M0,14 L14,0"
                          Stroke="{DynamicResource TextMutedBrush}"
                          StrokeThickness="1.5"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right"
                          Margin="0,0,2,2" />
                </Border>
            </Grid>
        </Border>

        <!-- ═══ 历史记录抽屉遮罩 ═══ -->
        <Grid Grid.RowSpan="7"
              Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <!-- 半透明遮罩（只覆盖左侧，不挡抽屉） -->
            <Rectangle Grid.Column="0" Fill="{DynamicResource OverlayBrush}" Opacity="0.3"
                       Cursor="Hand"
                       PreviewMouseDown="HistoryOverlay_MouseDown" />
            <!-- 抽屉面板（右侧滑出） -->
            <Border x:Name="HistoryDrawer"
                    Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    RenderTransformOrigin="1,0.5">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 抽屉标题 -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📋 历史记录"
                                       FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    x:Name="HistoryCloseButton"
                                    Command="{Binding ToggleHistoryCommand}"
                                    Cursor="Hand"
                                    Width="32" Height="32"
                                    BorderThickness="0"
                                    Padding="0"
                                    ToolTip="关闭"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                            <Path Data="M0,0 L12,12 M12,0 L0,12"
                                                  Stroke="{TemplateBinding Foreground}"
                                                  StrokeThickness="1.5"
                                                  StrokeEndLineCap="Round"
                                                  StrokeStartLineCap="Round"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  Width="12" Height="12"
                                                  Stretch="Uniform" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TitleBarPressedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 历史视频列表（按日期分组，纯展示无选中态） -->
                    <ScrollViewer Grid.Row="1"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HistoryGroups}"
                                      Background="Transparent"
                                      BorderThickness="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- 日期分组标题 -->
                                        <Border Background="{DynamicResource BackgroundBrush}"
                                                Padding="16,10,16,4">
                                            <TextBlock Text="{Binding GroupTitle}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>

                                        <!-- 该日期下的视频列表 -->
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      Background="Transparent"
                                                      BorderThickness="0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="16,10,16,10"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Cursor="Hand">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding Gesture="LeftClick"
                                                                          Command="{Binding DataContext.LoadFromHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}" />
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                                       Text="{Binding DisplayTitle}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                                       Text="{Binding TimeStr}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0,0,0" />

                                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                       Text="{Binding Summary}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 底部 -->
                    <TextBlock Grid.Row="2"
                               Text="单击条目加载历史"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Padding="16,8" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
