<ui:FluentWindow x:Class="BiliHelperWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:BiliHelperWpf.Converters"
        xmlns:local="clr-namespace:BiliHelperWpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="BiliHelper"
        Height="800" Width="1200"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        ResizeMode="CanResizeWithGrip"
        WindowBackdropType="None"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="pack://application:,,,/BiliHelperWpf;component/Assets/#Lilex Duo, Microsoft YaHei, PingFang SC, sans-serif"
        FontSize="14"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverted="True" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:StatusToColorConverter x:Key="StatusToColor" />



    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />    <!-- WPF-UI TitleBar（压到 32px，消除按钮下方空白带） -->
            <RowDefinition Height="Auto" />  <!-- URL 输入行 -->
            <RowDefinition Height="Auto" />  <!-- 进度 -->
            <RowDefinition Height="Auto" />  <!-- 错误 -->
            <RowDefinition Height="Auto" />  <!-- 元信息 -->
            <RowDefinition Height="*" />     <!-- 主体 -->
            <RowDefinition Height="Auto" />  <!-- 底栏 -->
        </Grid.RowDefinitions>

        <!-- ═══ WPF-UI 标题栏（自动处理拖拽、双击最大化、窗口按钮，主题感知） ═══ -->
        <ui:TitleBar x:Name="MainWindowTitleBar"
                     Grid.Row="0"
                     Height="32"
                     Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                     Title="BiliHelper"
                     CloseWindowByDoubleClickOnIcon="False">

        </ui:TitleBar>

        <!-- ═══ URL 输入行 ═══ -->
        <Border x:Name="UrlRow"
                Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0"
                                Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                FontSize="14"
                                Height="38"
                                VerticalContentAlignment="Center" />

                    <ui:Button Grid.Column="1"
                               Content="拉取字幕"
                               Command="{Binding FetchCommand}"
                               Height="38" Margin="8,0,0,0"
                               Padding="20,0" FontSize="13"
                               Appearance="Primary" />

                    <!-- 历史记录按钮 -->
                    <ui:Button Grid.Column="2"
                               Content="📋 历史"
                               Command="{Binding ToggleHistoryCommand}"
                               Height="38" Margin="8,0,0,0"
                               Padding="14,0"
                               FontSize="13"
                               Appearance="Secondary" />
                    <!-- 配置按钮 -->
                    <ui:Button Grid.Column="3"
                               Content="⚙️ 配置"
                               x:Name="SettingsButton"
                               Click="SettingsButton_Click"
                               Height="38" Margin="8,0,0,0"
                               Padding="14,0"
                               FontSize="13"
                               Appearance="Secondary" />
                </Grid>
                <TextBlock Text="💡 支持 BV 号 / 完整 URL / 多P合集 / 自动识别字幕语言"
                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- ═══ 进度条行 ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                Padding="16,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0"
                             Value="{Binding ProgressPercent}"
                             Minimum="0" Maximum="100"
                             Height="6"
                             Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                             Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                             BorderThickness="0" />

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}"
                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"
                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ 错误行 ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16,8"
                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       FontSize="13" TextWrapping="Wrap" />
        </Border>

        <!-- ═══ 视频元信息 ═══ -->
        <Border Grid.Row="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding HasVideoInfo, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="12" Height="12"
                         Fill="{Binding VideoInfo.Status, Converter={StaticResource StatusToColor}}"
                         VerticalAlignment="Center" Margin="0,0,10,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VideoInfo.Title}"
                               FontSize="16" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" MaxWidth="500" />
                    <TextBlock Text="{Binding VideoInfo.BvId, StringFormat='  ·  {0}'}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VideoInfo.StatusDisplay, StringFormat='  ·  {0}'}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding VideoInfo.TotalSubtitleCount, StringFormat='共 {0} 条字幕'}"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding VideoInfo.TotalParts, StringFormat='共 {0}P'}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═══ 主体区域 ═══ -->
        <Grid Grid.Row="5">
            <!-- 有数据时 -->
            <Grid Visibility="{Binding HasVideoInfo, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：分P列表 -->
                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1" Padding="14,10">
                            <TextBlock Text="{Binding VideoInfo.TotalParts, StringFormat='📋 分P 列表 ({0})'}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding VideoInfo.Parts}"
                                 SelectedItem="{Binding SelectedPart}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.IsContainerVirtualizable="True"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Grid.Column="0" Width="8" Height="8"
                                                 VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSubtitles}" Value="False">
                                                            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}"
                                                   FontSize="13" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding DurationFormatted}"
                                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 可拖拽分割条：叠在分P栏右缘，不占独立列，拖动调整左侧宽度 -->
                <GridSplitter Grid.Column="0" Width="5"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ResizeDirection="Columns" />

                <!-- 右侧：字幕区域（直接紧跟分割条，无独立中间列） -->
                <Border Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ═══ TAB 栏（WPF-UI TabControl；SelectedIndex 双向绑定 SelectedSubtitleTab） ═══ -->
                        <TabControl Grid.Row="0"
                                    SelectedIndex="{Binding SelectedSubtitleTab, Mode=TwoWay}"
                                    Background="Transparent"
                                    BorderThickness="0">
                            <TabItem HorizontalAlignment="Left"
                                     Margin="0,0,8,0"
                                     Padding="14,6">
                                <TabItem.Header>
                                    <StackPanel Width="88" VerticalAlignment="Center" Cursor="Hand">
                                        <TextBlock Text="原始字幕"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Height="2"
                                                CornerRadius="1"
                                                Width="56"
                                                HorizontalAlignment="Center"
                                                Margin="0,4,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Visibility="{Binding IsOriginalSubtitleVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 搜索栏 -->
                            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                    Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:TextBox Grid.Column="0"
                                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                FontSize="13"
                                                Height="32"
                                                VerticalContentAlignment="Center" />

                                    <TextBlock Grid.Column="1" Text="{Binding FilteredCount}"
                                               FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- 无选中分P时的占位 -->
                            <TextBlock Grid.Row="1"
                                       Text="← 从左侧选择一个分P"
                                       FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedPart, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />

                            <!-- 字幕列表容器 -->
                            <Grid Grid.Row="2">
                                <ListBox x:Name="SubtitleListBox"
                                         ItemsSource="{Binding FilteredEntries}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.IsContainerVirtualizable="True"
                                         ScrollViewer.CanContentScroll="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Grid.Column="0"
                                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="4"
                                                        Padding="8,4" VerticalAlignment="Top"
                                                        Margin="0,0,10,0" MinWidth="80">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding StartTimeFormatted}"
                                                                   FontSize="12" FontFamily="pack://application:,,,/BiliHelperWpf;component/Assets/#Lilex Duo"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding EndTimeFormatted}"
                                                                   FontSize="10" FontFamily="pack://application:,,,/BiliHelperWpf;component/Assets/#Lilex Duo"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <TextBlock Grid.Row="0" Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       FontSize="14" TextWrapping="Wrap"
                                                       LineHeight="22" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                            </TabItem>
                            <TabItem HorizontalAlignment="Left"
                                     Margin="0,0,8,0"
                                     Padding="14,6">
                                <TabItem.Header>
                                    <StackPanel Width="88" VerticalAlignment="Center" Cursor="Hand">
                                        <TextBlock Text="AI润色"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Height="2"
                                                CornerRadius="1"
                                                Width="56"
                                                HorizontalAlignment="Center"
                                                Margin="0,4,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid Visibility="{Binding IsFullTextVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />  <!-- 错误 -->
                                        <RowDefinition Height="Auto" />  <!-- 飞书同步状态 -->
                                        <RowDefinition Height="Auto" />  <!-- 无选中分P占位 -->
                                        <RowDefinition Height="*" />     <!-- 内容区：未整理卡片 / 段落列表 -->
                                    </Grid.RowDefinitions>

                            <!-- 错误提示（WPF-UI InfoBar） -->
                            <ui:InfoBar Grid.Row="0"
                                        Title="AI 整理失败"
                                        Message="{Binding AiReadErrorMessage, Mode=OneWay}"
                                        Severity="Error"
                                        IsClosable="False"
                                        Margin="12,8"
                                        IsOpen="{Binding AiReadError, Mode=OneWay}" />

                            <!-- 飞书同步状态行（🔄同步中 / ✓已同步 / ⚠失败+重试） -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,4">
                                <TextBlock Text="{Binding FeishuSyncStatus}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <ui:Button Content="重试"
                                           Command="{Binding FeishuRetryCommand}"
                                           Visibility="{Binding FeishuSyncFailed, Converter={StaticResource BoolToVis}}"
                                           FontSize="12"
                                           Padding="10,2"
                                           Margin="10,0,0,0"
                                           Appearance="Secondary" />
                            </StackPanel>

                            <!-- 无选中分P时的占位 -->
                            <TextBlock Grid.Row="2"
                                       Text="← 从左侧选择一个分P"
                                       FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedPart, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />

                            <!-- 未整理时的占位（有选中分P，但还没有 AI 段落） -->
                            <Border Grid.Row="3"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="48,36"
                                    MaxWidth="400"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowAiReadEmptyCard, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📄"
                                               FontSize="44"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="该分P 尚未进行 AI 整理"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,16,0,0" />
                                    <TextBlock Text="AI 将修正错别字、添加标点并分段，生成适合阅读的全文"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0" />
                                    <!-- 整理中隐藏按钮，进度文本显示在按钮下方 -->
                                    <ui:Button Content="✨ 立即整理当前分P"
                                            Command="{Binding AiReadCommand}"
                                            Height="36"
                                            Padding="20,0"
                                            Margin="0,20,0,0"
                                            FontSize="13"
                                            Appearance="Primary"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding IsAiReadBusy, Converter={StaticResource InverseBoolToVis}}">
                                    </ui:Button>
                                    <TextBlock Text="{Binding AiReadStatus}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,14,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 段落列表（已整理的阅读版） -->
                            <ScrollViewer Grid.Row="3"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="24,16"
                                          Background="Transparent"
                                          Visibility="{Binding HasAiParagraphs, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding AiParagraphs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,18">
                                                <TextBlock Text="{Binding Text}"
                                                           FontSize="15" LineHeight="28" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding SourceStartIndex, StringFormat='↳ 字幕 #{0}'}"
                                                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                            </TabItem>
                        </TabControl>


                    </Grid>
                </Border>
            </Grid>

            <!-- 空状态占位 -->
            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    Visibility="{Binding HasVideoInfo, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎬" FontSize="64" HorizontalAlignment="Center" />
                    <TextBlock Text="输入视频 URL 并点击「拉取字幕」"
                               FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="支持 BV 号 · 完整链接 · 多P 视频 · AI 字幕 / CC 字幕"
                               FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ 底栏 ═══ -->
        <Border Grid.Row="6" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="16,6"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" />
                <!-- 右下角调整大小手柄 -->
                <Border Grid.Column="1" Width="16" Height="14"
                        VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Opacity="0.4">
                    <Path Data="M0,14 L14,0"
                          Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                          StrokeThickness="1.5"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Right"
                          Margin="0,0,2,2" />
                </Border>
            </Grid>
        </Border>

        <!-- ═══ 历史记录抽屉遮罩（覆盖整窗含标题栏；抽屉背景不透明盖住标题栏按钮，✕ 关闭按钮在抽屉右上角；TitleBar 的 HTCAPTION 劫持由 code-behind 在抽屉打开时设 IsHitTestVisible=false 解除，✕ 可正常点击，标题栏不可操作） ═══ -->
        <Grid Grid.RowSpan="7"
              Visibility="{Binding IsHistoryOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>
            <!-- 内容区半透明遮罩（只覆盖左侧，不挡抽屉）——黑色半透明在深色/浅色下都协调，避免深色下亮灰遮罩发白 -->
            <Rectangle Grid.Column="0" Fill="Black" Opacity="0.3"
                       Cursor="Hand"
                       PreviewMouseDown="HistoryOverlay_MouseDown" />
            <!-- 抽屉面板（右侧滑出，占满整窗含标题栏区域） -->
            <Border x:Name="HistoryDrawer"
                    Grid.Column="1"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    RenderTransformOrigin="1,0.5">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 抽屉标题 -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="📋 历史记录"
                                       FontSize="15" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <ui:Button Grid.Column="1"
                                       x:Name="HistoryCloseButton"
                                       Command="{Binding ToggleHistoryCommand}"
                                       Width="32" Height="32"
                                       Padding="0"
                                       ToolTip="关闭"
                                       Appearance="Transparent"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Path Data="M0,0 L12,12 M12,0 L0,12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                      StrokeThickness="1.5"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      Width="12" Height="12"
                                      Stretch="Uniform" />
                            </ui:Button>
                        </Grid>
                    </Border>

                    <!-- 历史视频列表（按日期分组，纯展示无选中态） -->
                    <ScrollViewer Grid.Row="1"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HistoryGroups}"
                                      Background="Transparent"
                                      BorderThickness="0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- 日期分组标题 -->
                                        <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                                Padding="16,10,16,4">
                                            <TextBlock Text="{Binding GroupTitle}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>

                                        <!-- 该日期下的视频列表 -->
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      Background="Transparent"
                                                      BorderThickness="0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="16,10,16,10"
                                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Cursor="Hand">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ControlAltFillColorSecondaryBrush}" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.InputBindings>
                                                            <MouseBinding Gesture="LeftClick"
                                                                          Command="{Binding DataContext.LoadFromHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          CommandParameter="{Binding}" />
                                                        </Border.InputBindings>
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                                       Text="{Binding DisplayTitle}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <StackPanel Grid.Row="0" Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TimeStr}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <ui:Button Content="✕"
                                                                           ToolTip="删除该历史记录"
                                                                           Width="26" Height="26"
                                                                           Padding="0" Margin="10,0,0,0"
                                                                           FontSize="11"
                                                                           Appearance="Transparent"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                           Command="{Binding DataContext.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                           CommandParameter="{Binding}" />
                                                            </StackPanel>

                                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                                       Text="{Binding Summary}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 底部 -->
                    <TextBlock Grid.Row="2"
                               Text="单击条目加载历史"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Padding="16,8" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
