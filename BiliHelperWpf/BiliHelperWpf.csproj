<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\alma.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <Product>BiliHelper</Product>
    <AssemblyTitle>BiliHelper</AssemblyTitle>
    <Description>B 站字幕提取 + AI 润色 + 飞书同步桌面工具</Description>
    <Authors>RoanWolf</Authors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\alma.ico" />
    <Resource Include="Assets\LilexDuo-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
