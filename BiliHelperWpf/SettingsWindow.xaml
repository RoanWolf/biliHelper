<ui:FluentWindow x:Class="BiliHelperWpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BiliHelperWpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置"
        Width="880" Height="620"
        MinWidth="880" MaxWidth="880"
        MinHeight="620" MaxHeight="620"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        ResizeMode="NoResize"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="pack://application:,,,/BiliHelperWpf;component/Assets/#Lilex Duo, Microsoft YaHei, PingFang SC, sans-serif"
        FontSize="14"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Settings/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <!-- 内容根：圆角框，带边框色（与主界面区分） -->
    <Border CornerRadius="10"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />  <!-- WPF-UI TitleBar（压到 32px，消除按钮下方空白带） -->
            <RowDefinition Height="*" />   <!-- 主体 -->
        </Grid.RowDefinitions>

        <!-- ═══ WPF-UI 标题栏（自动拖拽/双击最大化/窗口按钮，主题感知） ═══ -->
        <ui:TitleBar Grid.Row="0"
                     Height="32"
                     Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                     Title="设置"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     CloseWindowByDoubleClickOnIcon="False">

        </ui:TitleBar>

        <!-- ═══ 主体：左侧分组导航 + 右侧内容 ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─── 左侧导航（分组 + 底部版本信息） ─── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    CornerRadius="0,0,0,10">
                <Grid>
                    <StackPanel Margin="16,18,12,8">
                        <!-- 服务 -->
                        <ContentControl Content="服务"
                                        FontSize="12" FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource FluentGroupTitleStyle}" />

                        <RadioButton x:Name="NavAccount"
                                     Tag="0"
                                     GroupName="Nav"
                                     Style="{StaticResource FluentNavItemStyle}"
                                     Checked="Nav_Checked">
                            <TextBlock Text="获取cookie" Style="{StaticResource FluentNavLabelStyle}" />
                        </RadioButton>

                        <RadioButton x:Name="NavAi"
                                     Tag="1"
                                     GroupName="Nav"
                                     Style="{StaticResource FluentNavItemStyle}"
                                     Checked="Nav_Checked">
                            <TextBlock Text="AI模型" Style="{StaticResource FluentNavLabelStyle}" />
                        </RadioButton>

                        <RadioButton x:Name="NavFeishu"
                                     Tag="2"
                                     GroupName="Nav"
                                     Style="{StaticResource FluentNavItemStyle}"
                                     Checked="Nav_Checked">
                            <TextBlock Text="飞书" Style="{StaticResource FluentNavLabelStyle}" />
                        </RadioButton>

                        <!-- 个性化 -->
                        <ContentControl Content="个性化"
                                        FontSize="12" FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource FluentGroupTitleStyle}"
                                        Margin="0,18,0,0" />

                        <RadioButton x:Name="NavAppearance"
                                     Tag="3"
                                     GroupName="Nav"
                                     Style="{StaticResource FluentNavItemStyle}"
                                     Checked="Nav_Checked">
                            <TextBlock Text="外观" Style="{StaticResource FluentNavLabelStyle}" />
                        </RadioButton>
                    </StackPanel>

                    <!-- 版本信息 -->
                    <StackPanel VerticalAlignment="Bottom" Margin="20,12,12,16">
                        <Border Style="{StaticResource FluentDividerStyle}" Margin="0,0,8,12" />
                        <TextBlock Text="BiliHelper v1.0.0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 导航 / 内容 分隔线 -->
            <Border Grid.Column="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <!-- ─── 右侧内容区 ─── -->
            <Grid Grid.Column="2">
                <ContentControl x:Name="ContentHost" Margin="44,36,44,30" />
            </Grid>
        </Grid>
    </Grid>
    </Border>
</ui:FluentWindow>
