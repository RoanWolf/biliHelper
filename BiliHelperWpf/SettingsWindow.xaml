<Window x:Class="BiliHelperWpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · AI 大模型"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- 与 LoginWindow 相同的本地按钮样式（独立窗口，无法引用主窗口样式） -->
        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="28,24">
            <StackPanel>
                <!-- 标题 -->
                <TextBlock Text="⚙️ AI 大模型设置"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="留空则使用 BiliHelperCore/.env 中的默认配置"
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,20" />

                <!-- API Key -->
                <TextBlock Text="API Key（DeepSeek / 任意 OpenAI 兼容服务）"
                           Style="{StaticResource FieldLabelStyle}" />
                <PasswordBox x:Name="ApiKeyBox"
                             Height="34" Padding="10,0"
                             Background="{DynamicResource InputBgBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource PrimaryBrush}" />

                <!-- Base URL -->
                <TextBlock Text="Base URL（可选，默认 https://api.deepseek.com）"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,14,0,4" />
                <TextBox x:Name="BaseUrlBox"
                         Height="34" Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBgBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource PrimaryBrush}" />

                <!-- Model -->
                <TextBlock Text="模型（可选，默认 deepseek-v4-flash）"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,14,0,4" />
                <TextBox x:Name="ModelBox"
                         Height="34" Padding="10,0"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBgBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource PrimaryBrush}" />

                <!-- 测试结果状态 -->
                <Border x:Name="TestResultBox"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="12,10"
                        Margin="0,16,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TestResultText"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- 操作按钮 -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="🔌 测试连通性"
                            x:Name="TestButton"
                            Style="{StaticResource SettingsButtonStyle}"
                            FontSize="13" Margin="0,0,6,0"
                            Click="TestButton_Click" />
                    <Button Grid.Column="1"
                            Content="保存"
                            x:Name="SaveButton"
                            Style="{StaticResource SettingsButtonStyle}"
                            FontSize="13" Margin="6,0,6,0"
                            Click="SaveButton_Click" />
                    <Button Grid.Column="2"
                            Content="取消"
                            x:Name="CancelButton"
                            Style="{StaticResource SettingsButtonStyle}"
                            FontSize="13" Margin="6,0,0,0"
                            Click="CancelButton_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>