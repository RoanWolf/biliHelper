<UserControl x:Class="BiliHelperWpf.Settings.AiModelPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">
        <StackPanel MaxWidth="540" HorizontalAlignment="Left">
            <!-- ═══ 标题行：左标题 + 右上角操作按钮 ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="AI 大模型"
                           Style="{StaticResource FluentPageTitleStyle}"
                           VerticalAlignment="Center" />

                <!-- 右上角：测试 + 保存 -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="TestButton"
                            Content="测试连通性"
                            Style="{StaticResource FluentButtonStyle}"
                            FontSize="13"
                            Click="TestButton_Click" />
                    <Button x:Name="SaveButton"
                            Content="保存"
                            Style="{StaticResource FluentPrimaryButtonStyle}"
                            FontSize="13"
                            Margin="12,0,0,0"
                            Click="SaveButton_Click" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource FluentSectionDividerStyle}" />

            <!-- ═══ 连接配置 ═══ -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="28,24">
                <StackPanel>
                    <ContentControl Content="连接配置"
                                    FontSize="13" FontWeight="SemiBold"
                                    Style="{StaticResource FluentGroupTitleStyle}" />

                    <!-- API Key -->
                    <TextBlock Text="API Key" Style="{StaticResource FluentFieldLabelStyle}" />
                    <PasswordBox x:Name="ApiKeyBox"
                                 Style="{StaticResource FluentPasswordBoxStyle}" />
                    <!-- Base URL -->
                    <TextBlock Text="Base URL"
                               Style="{StaticResource FluentFieldLabelStyle}"
                               Margin="0,18,0,8" />
                    <TextBox x:Name="BaseUrlBox"
                             Style="{StaticResource FluentTextBoxStyle}"
                             Text="https://api.deepseek.com" />
                    <!-- 模型 -->
                    <TextBlock Text="模型"
                               Style="{StaticResource FluentFieldLabelStyle}"
                               Margin="0,18,0,8" />
                    <TextBox x:Name="ModelBox"
                             Style="{StaticResource FluentTextBoxStyle}"
                             Text="deepseek-v4-flash" />
                </StackPanel>
            </Border>

            <!-- ═══ 测试结果（并入连接配置卡片下方） ═══ -->
            <!-- 整卡着色跟随 TestResultText.Foreground（code-behind 设为 成功绿 / 失败红） -->
            <Border x:Name="TestResultBox"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,16,0,0">
                <Grid>
                    <!-- 半透明着色层：随状态染上 成功/失败 底色 -->
                    <Border Background="{Binding Foreground, ElementName=TestResultText}"
                            Opacity="0.08"
                            CornerRadius="8" />
                    <!-- 左侧色条 -->
                    <Border HorizontalAlignment="Left"
                            Width="4"
                            CornerRadius="2,0,0,2"
                            Background="{Binding Foreground, ElementName=TestResultText}" />
                    <!-- 状态文字（code-behind 写入 ✔/✖ + 消息） -->
                    <TextBlock x:Name="TestResultText"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="16,12" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
