<UserControl x:Class="BiliHelperWpf.Settings.AccountPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0">
        <StackPanel>
            <!-- ═══ 标题行：左标题 + 右上角操作按钮（与 AI 面板布局统一，宽度与卡片对齐） ═══ -->
            <Grid Width="540" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="账号"
                           Style="{StaticResource FluentPageTitleStyle}"
                           VerticalAlignment="Center" />

                <!-- 退出登录：仅已登录时显示 -->
                <ui:Button Grid.Column="1"
                           Content="退出登录"
                           Appearance="Secondary"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Visibility="{Binding Visibility, ElementName=LoggedInPanel}"
                           Click="LogoutButton_Click" />
            </Grid>

            <Border Style="{StaticResource FluentSectionDividerStyle}" />

            <!-- ═══ 已登录：欢迎卡片（水平布局，固定宽度靠左） ═══ -->
            <StackPanel x:Name="LoggedInPanel" Visibility="Collapsed">
                <Border Style="{StaticResource FluentCardStyle}"
                        Width="540"
                        HorizontalAlignment="Left"
                        Padding="28,26">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：头像 -->
                        <Border Grid.Column="0"
                                Width="80" Height="80"
                                CornerRadius="40"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Top"
                                ClipToBounds="True">
                            <Grid>
                                <Image x:Name="UserAvatar"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       ImageFailed="UserAvatar_ImageFailed" />
                                <TextBlock x:Name="AvatarFallback"
                                           Text="👤"
                                           FontSize="34"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!-- 右侧：昵称 / UID / 状态 -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <!-- 昵称 + 已登录标签 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="UserNameText"
                                           Text="..."
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="{DynamicResource ControlAltFillColorSecondaryBrush}"
                                        CornerRadius="10"
                                        Padding="10,3"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="已登录"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>

                            <!-- UID -->
                            <TextBlock x:Name="UserUidText"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,8,0,0" />

                            <!-- 分隔线 -->
                            <Border Height="1"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    Margin="0,16,0,14" />

                            <!-- 状态提示（续期信息等） -->
                            <TextBlock x:Name="StatusInfo"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="18" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ═══ 未登录：扫码 ═══ -->
            <StackPanel x:Name="LoginPanel" Visibility="Collapsed">
                <Border Style="{StaticResource FluentCardStyle}"
                        Width="540"
                        HorizontalAlignment="Left"
                        Padding="36,32">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="扫码登录 B 站"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="使用 B 站 App 扫描二维码，登录后自动保存"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,20" />

                        <Border Background="{DynamicResource TextControlBackground}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Width="200" Height="200"
                                HorizontalAlignment="Center"
                                Padding="6">
                            <Image x:Name="QrImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <TextBlock x:Name="StatusText"
                                   Text="正在生成二维码..."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,18,0,20" />

                        <ui:Button Content="重新生成"
                                   x:Name="RegenButton"
                                   Appearance="Secondary"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   IsEnabled="False"
                                   Click="RegenButton_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
